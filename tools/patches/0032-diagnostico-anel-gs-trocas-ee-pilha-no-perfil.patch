+namespace
+{
+    // Debug aid: PS2X_EE_STAT=1 imprime a cada ~5 s quantas trocas por excecao (EeDispatcherTransfer) houve, por origem, e o tempo do throw ao catch.
+    const bool g_eeStatLigado = std::getenv("PS2X_EE_STAT") != nullptr;
+    struct EstatisticaTroca
+    {
+        uint64_t porOrigem[8]{};
+        uint64_t total = 0u;
+        std::chrono::steady_clock::duration tempo{};
+        std::chrono::steady_clock::time_point lancamento{};
+        std::chrono::steady_clock::time_point inicio = std::chrono::steady_clock::now();
+    };
+    EstatisticaTroca g_troca;
+
+    inline void marcaTroca(int origem)
+    {
+        if (!g_eeStatLigado)
+            return;
+        ++g_troca.porOrigem[origem & 7];
+        ++g_troca.total;
+        g_troca.lancamento = std::chrono::steady_clock::now();
+    }
+
+    inline void chegouTroca()
+    {
+        if (!g_eeStatLigado || g_troca.lancamento == std::chrono::steady_clock::time_point{})
+            return;
+        const auto agora = std::chrono::steady_clock::now();
+        g_troca.tempo += agora - g_troca.lancamento;
+        g_troca.lancamento = {};
+        if (agora - g_troca.inicio > std::chrono::seconds(5))
+        {
+            const EstatisticaTroca &e = g_troca;
+            std::fprintf(stderr, "[ee-troca] total=%llu fim_thread=%llu pedido=%llu invoca=%llu invoca_lista=%llu bloqueio=%llu ms=%lld total_ms=%lld%c",
+                         (unsigned long long)e.total, (unsigned long long)e.porOrigem[0], (unsigned long long)e.porOrigem[1],
+                         (unsigned long long)e.porOrigem[2], (unsigned long long)e.porOrigem[3], (unsigned long long)e.porOrigem[4],
+                         (long long)std::chrono::duration_cast<std::chrono::milliseconds>(e.tempo).count(),
+                         (long long)std::chrono::duration_cast<std::chrono::milliseconds>(agora - e.inicio).count(), 10);
+            g_troca = {};
+        }
+    }
+}
 
