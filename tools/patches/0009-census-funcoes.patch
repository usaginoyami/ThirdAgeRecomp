+// Debug aid: PS2X_CENSUS=1 conta entradas de funcoes recompiladas e imprime as mais chamadas.
+// O trace de entrada/saida em arquivo (lento) so liga com PS2X_FNLOG=1.
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <unordered_map>
+namespace ps2_log
+{
+inline bool fnlog_enabled()
+{
+    static const bool enabled = std::getenv("PS2X_FNLOG") != nullptr;
+    return enabled;
+}
+inline void census_hit(const char *name)
+{
+    static const bool enabled = std::getenv("PS2X_CENSUS") != nullptr;
+    if (!enabled)
+        return;
+    static std::mutex mtx;
+    static std::unordered_map<std::string, uint64_t> counts;
+    static uint64_t total = 0;
+    static int dumps = 0;
+    std::lock_guard<std::mutex> lock(mtx);
+    ++counts[name];
+    if (++total >= 200000ull && dumps < 8)
+    {
+        std::vector<std::pair<std::string, uint64_t>> v(counts.begin(), counts.end());
+        std::sort(v.begin(), v.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+        std::fprintf(stderr, "[census] dump %d (200k entradas)\n", dumps);
+        for (size_t i = 0; i < v.size() && i < 40; ++i)
+            std::fprintf(stderr, "[census] %8llu %s\n", (unsigned long long)v[i].second, v[i].first.c_str());
+        ++dumps;
+        counts.clear();
+        total = 0;
+    }
+}
+}
+
 #if AGRESSIVE_LOGS
 
 namespace ps2_log
@@ -162,6 +201,9 @@
 }
