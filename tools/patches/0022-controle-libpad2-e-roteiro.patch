+    {
+        struct Toque
+        {
+            double inicio = 0.0;
+            uint16_t mascara = 0u;
+            bool avisado = false;
+        };
+        static std::vector<Toque> roteiro = []
+        {
+            std::vector<Toque> saida;
+            if (const char *env = std::getenv("PS2X_PAD_SCRIPT"))
+            {
+                std::istringstream texto(env);
+                std::string item;
+                while (std::getline(texto, item, ';'))
+                {
+                    const size_t sep = item.find(':');
+                    if (sep == std::string::npos)
+                        continue;
+                    Toque toque;
+                    toque.inicio = std::strtod(item.c_str(), nullptr);
+                    toque.mascara = static_cast<uint16_t>(std::strtoul(item.c_str() + sep + 1u, nullptr, 16));
+                    saida.push_back(toque);
+                }
+            }
+            return saida;
+        }();
+        static const auto partida = std::chrono::steady_clock::now();
+        const double agora = std::chrono::duration<double>(std::chrono::steady_clock::now() - partida).count();
+        for (Toque &toque : roteiro)
+        {
+            if (agora >= toque.inicio && agora < toque.inicio + 0.5)
+            {
+                clearBit(toque.mascara);
+                if (!toque.avisado)
+                {
+                    toque.avisado = true;
+                    std::fprintf(stderr, "[pad] toque 0x%04x em %.1f s%c", static_cast<unsigned>(toque.mascara), agora, 10);
+                }
+            }
+        }
+    }
