+    void gsHistCount(const std::string &chave)
+    {
+        ++g_gsHist[chave];
+    }
+
+    void gsHistFlushIfDue()
+    {
+        if (++g_gsHistTotal < gsHistInterval())
+            return;
+        std::fprintf(stderr, "[gs:hist] inicio%c", 10);
+        for (const auto &item : g_gsHist)
+            std::fprintf(stderr, "[gs:hist] %8llu %s%c", static_cast<unsigned long long>(item.second), item.first.c_str(), 10);
+        g_gsHist.clear();
+        g_gsHistTotal = 0u;
+    }
