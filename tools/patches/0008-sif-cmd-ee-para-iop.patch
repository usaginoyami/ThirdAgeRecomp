+    bool IopRpcBridge::dispatchCmd(uint32_t commandId, const void *packet, uint32_t packetSize, IopGuestExecutor &executor)
+    {
+        const auto it = m_cmdHandlers.find(commandId);
+        if (it == m_cmdHandlers.end() || it->second.function == 0u || packet == nullptr || packetSize == 0u)
+            return false;
+        const CmdHandler handler = it->second;
+        const uint32_t size = (packetSize < 112u) ? 112u : packetSize;
+        const uint32_t address = m_memory.allocate(size, 16u);
+        if (address == 0u)
+            return false;
+        (void)m_memory.writeRam(address, packet, packetSize);
+        (void)executor.executeGuestFunction(handler.function, address, handler.argument, 0u, 0u, handler.gp);
+        (void)m_memory.freeAllocation(address);
+        return true;
+    }
+
