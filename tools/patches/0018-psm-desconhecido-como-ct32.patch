 #include <sstream>
 #include <unordered_map>
 
+namespace
+{
+    // PSM nao documentado (o Third Age usa 0x20 na textura dos filmes, enviada como CT32) e tratado como CT32 pelo
+    // hardware; o backend devolveria branco para ele.
+    uint8_t normalizeTexturePsm(uint8_t psm)
+    {
+        switch (psm)
+        {
+        case 0x00: case 0x01: case 0x02: case 0x0A: case 0x13: case 0x14: case 0x1B:
+        case 0x24: case 0x2C: case 0x30: case 0x31: case 0x32: case 0x3A:
+            return psm;
+        default:
+            return 0x00;
+        }
+    }
+}
