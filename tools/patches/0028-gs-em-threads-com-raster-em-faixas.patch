+namespace
+{
+    // Cada thread de desenho so escreve as linhas da sua faixa (16 linhas). Toda primitiva passa por todas as threads, na mesma ordem,
+    // entao cada pixel continua vendo as primitivas na ordem original. Fora das threads (t_faixa < 0) tudo e desenhado.
+    thread_local int t_faixa = -1;
+    thread_local int t_totalFaixas = 1;
+    thread_local int t_cacheTextura = 0;
+
+    inline bool faixaDonaDaLinha(int y)
+    {
+        return t_totalFaixas <= 1 || ((y >> 4) % t_totalFaixas) == t_faixa;
+    }
+
+    inline void esperaCurta()
+    {
+#if defined(__x86_64__) || defined(_M_X64)
+        _mm_pause();
+#else
+        std::this_thread::yield();
+#endif
+    }
+}
+
+enum class TipoComandoGs : uint8_t
+{
+    Desenho,
+    Sincronia,
+    Clut,
+    IniciaTransferencia,
+    Imagem,
+    TexFlush,
+    EscreveVram,
+    Parar
+};
+
+struct ComandoGs
+{
+    TipoComandoGs tipo = TipoComandoGs::Sincronia;
+    GSPrimitiveBatch batch{};
+    GSTex0Reg tex0{};
+    GSTexClutReg texclut{};
+    GSTransferCommand transferencia{};
+    std::vector<uint8_t> dados;
+    uint32_t psm = 0u, base = 0u, bw = 0u, x = 0u, y = 0u, valor = 0u;
+};
+
+struct GSCpuBackend::Fila
+{
+    static constexpr uint64_t kTamanho = 1u << 14u;
+    std::vector<ComandoGs> anel = std::vector<ComandoGs>(kTamanho);
+    alignas(64) std::atomic<uint64_t> cabeca{0u};
+    alignas(64) std::atomic<int> dormindo{0};
+    alignas(64) std::atomic<int> chegaram{0};
+    alignas(64) std::atomic<uint64_t> barreiras{0u};
+    struct Cauda
+    {
+        alignas(64) std::atomic<uint64_t> valor{0u};
+    };
+    std::array<Cauda, GSCpuBackend::kMaxThreads> caudas{};
+    std::vector<std::thread> threads;
+    int total = 0;
+    // Paginas desenhadas desde a ultima sincronia (so a thread que publica usa).
+    std::bitset<512> paginasSujas;
+
+    uint64_t menorCauda() const
+    {
+        uint64_t menor = caudas[0].valor.load(std::memory_order_acquire);
+        for (int i = 1; i < total; ++i)
+            menor = std::min(menor, caudas[i].valor.load(std::memory_order_acquire));
+        return menor;
+    }
+
+    ComandoGs &reservar()
+    {
+        const uint64_t h = cabeca.load(std::memory_order_relaxed);
+        while (h - menorCauda() >= kTamanho)
+            std::this_thread::yield();
+        return anel[h & (kTamanho - 1u)];
+    }
+
+    void publicar()
+    {
+        const uint64_t h = cabeca.load(std::memory_order_relaxed) + 1u;
+        cabeca.store(h, std::memory_order_seq_cst);
+        if (dormindo.load(std::memory_order_seq_cst) != 0)
+            cabeca.notify_all();
+    }
+};
+
+GSCpuBackend::~GSCpuBackend()
+{
+    pararFila();
+}
+
+bool GSCpuBackend::usaFila() const
+{
+    return m_fila && t_faixa < 0;
+}
+
+void GSCpuBackend::iniciarFila()
+{
+    if (m_fila || !m_permiteFila)
+        return;
+    int total = static_cast<int>(std::thread::hardware_concurrency());
+    total = std::clamp(total - 2, 0, 8);
+    if (const char *env = std::getenv("PS2X_GS_THREADS"))
+        total = std::clamp(std::atoi(env), 0, kMaxThreads);
+    if (total <= 0)
+        return;
+    m_fila = std::make_unique<Fila>();
+    m_fila->total = total;
+    for (int i = 0; i < total; ++i)
+        m_fila->threads.emplace_back([this, i] { executarLoop(i); });
+    std::fprintf(stderr, "[gs] %d threads de desenho%c", total, 10);
+}
+
+void GSCpuBackend::pararFila()
+{
+    if (!m_fila)
+        return;
+    m_fila->reservar().tipo = TipoComandoGs::Parar;
+    m_fila->publicar();
+    for (std::thread &t : m_fila->threads)
+        t.join();
+    m_fila.reset();
+}
+
+void GSCpuBackend::drenarFila() const
+{
+    if (!m_fila || t_faixa >= 0)
+        return;
+    const uint64_t h = m_fila->cabeca.load(std::memory_order_relaxed);
+    while (m_fila->menorCauda() < h)
+        std::this_thread::yield();
+}
+
+void GSCpuBackend::executarBarreira(ComandoGs &comando)
+{
+    switch (comando.tipo)
+    {
+    case TipoComandoGs::Clut:
+        LoadClut(comando.tex0, comando.texclut);
+        break;
+    case TipoComandoGs::IniciaTransferencia:
+        BeginTransfer(comando.transferencia);
+        break;
+    case TipoComandoGs::Imagem:
+        UploadImage(comando.dados.data(), static_cast<uint32_t>(comando.dados.size()));
+        break;
+    case TipoComandoGs::TexFlush:
+        TextureFlush();
+        break;
+    case TipoComandoGs::EscreveVram:
+        WriteVram(comando.psm, comando.base, comando.bw, comando.x, comando.y, comando.valor);
+        break;
+    default:
+        break;
+    }
+}
+
+void GSCpuBackend::executarLoop(int faixa)
+{
+    t_faixa = faixa;
+    t_totalFaixas = m_fila->total;
+    t_cacheTextura = faixa + 1;
+    Fila &fila = *m_fila;
+    uint64_t proximo = 0u;
+    for (;;)
+    {
+        uint64_t h = fila.cabeca.load(std::memory_order_acquire);
+        for (int giros = 0; h == proximo && giros < 4000; ++giros)
+        {
+            esperaCurta();
+            h = fila.cabeca.load(std::memory_order_acquire);
+        }
+        if (h == proximo)
+        {
+            fila.dormindo.fetch_add(1, std::memory_order_seq_cst);
+            fila.cabeca.wait(proximo, std::memory_order_seq_cst);
+            fila.dormindo.fetch_sub(1, std::memory_order_seq_cst);
+            continue;
+        }
+        ComandoGs &comando = fila.anel[proximo & (Fila::kTamanho - 1u)];
+        if (comando.tipo == TipoComandoGs::Parar)
+            return;
+        if (comando.tipo == TipoComandoGs::Desenho)
+        {
+            if (m_vram)
+                DrawPrimitive(comando.batch);
+        }
+        else
+        {
+            // Barreira: todas as threads terminaram o que veio antes; a ultima a chegar executa e libera as demais.
+            const uint64_t numero = fila.barreiras.load(std::memory_order_acquire);
+            if (fila.chegaram.fetch_add(1, std::memory_order_acq_rel) + 1 == fila.total)
+            {
+                executarBarreira(comando);
+                fila.chegaram.store(0, std::memory_order_release);
+                fila.barreiras.store(numero + 1u, std::memory_order_release);
+            }
+            else
+            {
+                while (fila.barreiras.load(std::memory_order_acquire) == numero)
+                    esperaCurta();
+            }
+        }
+        ++proximo;
+        fila.caudas[faixa].valor.store(proximo, std::memory_order_release);
+    }
+}
