+// Um par de instrucoes do VU com o modelo de tempo completo: o corpo do laco de VU1Interpreter::run.
+// Incluido por ps2_vu1_core.cpp (interpretador) e por ps2_vu1_traduzido.cpp (blocos traduzidos), que passam o par ja
+// decodificado. Os dois caminhos executam exatamente o mesmo codigo; o traduzido so evita a busca no cache e o despacho.
+#ifndef PS2_VU1_PASSO_INL
+#define PS2_VU1_PASSO_INL
+
+#include "runtime/ps2_vu1.h"
+#include <cstring>
+
+// Definido em ps2_vu1_core.cpp: falso com PS2X_VU_FILAS=1 (modelo antigo, com as filas de escrita de VF/VI/ACC).
+extern const bool g_ps2xVuEscritaImediata;
+
+namespace vu1passo
+{
+    constexpr uint8_t pista(uint32_t component)
+    {
+        return static_cast<uint8_t>(1u << (3u - component));
+    }
+}
+
+#if defined(__GNUC__) || defined(__clang__)
+#define PS2_VU1_SEMPRE_EMBUTIR __attribute__((always_inline)) inline
+#else
+#define PS2_VU1_SEMPRE_EMBUTIR __forceinline
+#endif
+
+PS2_VU1_SEMPRE_EMBUTIR uint64_t VU1Interpreter::calculatePairReadyCycle(const DecodedInstructionPair &decoded) const
+{
+    uint64_t ready = m_cycle;
+    const InstructionUsage *usages[2] = {
+        &decoded.upperUsage,
+        &decoded.lowerUsage};
+    for (const InstructionUsage *usage : usages)
+    {
+        if (!usage)
+            continue;
+        // Na maioria dos pares nada esta pendente: o bit 63 de (ciclo - pronto) so liga se pronto > ciclo, sem desvio por componente.
+        // Entradas de vfRead nao usadas ficam {0, 0}: mascara zero, nao contam.
+        uint64_t pendente = 0u;
+        for (uint32_t index = 0; index < usage->vfRead.size(); ++index)
+        {
+            const VfAccess &access = usage->vfRead[index];
+            const std::array<uint64_t, 4> &prontos = m_vfReady[access.reg];
+            const uint64_t lanes = access.lanes;
+            pendente |= (m_cycle - prontos[0]) & (0u - ((lanes >> 3) & 1u));
+            pendente |= (m_cycle - prontos[1]) & (0u - ((lanes >> 2) & 1u));
+            pendente |= (m_cycle - prontos[2]) & (0u - ((lanes >> 1) & 1u));
+            pendente |= (m_cycle - prontos[3]) & (0u - (lanes & 1u));
+        }
+        if ((pendente >> 63) != 0u)
+        {
+            for (uint32_t index = 0; index < usage->vfReadCount; ++index)
+            {
+                const VfAccess &access = usage->vfRead[index];
+                for (uint32_t component = 0; component < 4u; ++component)
+                {
+                    if ((access.lanes & vu1passo::pista(component)) != 0u)
+                        ready = std::max(ready, m_vfReady[access.reg][component]);
+                }
+            }
+        }
+        if ((usage->viRead & ~1u) != 0u)
+        {
+            for (uint32_t reg = 1; reg < m_viReady.size(); ++reg)
+            {
+                if ((usage->viRead & (1u << reg)) != 0u)
+                    ready = std::max(ready, m_viReady[reg]);
+            }
+        }
+        if (usage->accRead != 0u)
+        {
+            for (uint32_t component = 0; component < 4u; ++component)
+            {
+                if ((usage->accRead & vu1passo::pista(component)) != 0u)
+                    ready = std::max(ready, m_accReady[component]);
+            }
+        }
+    }
+
+    if (decoded.lowerUsage.pipeline == PipelineFdiv && m_fdiv.valid)
+        ready = std::max(ready, m_fdiv.readyCycle);
+    if (decoded.lowerUsage.pipeline == PipelineEfu)
+        ready = std::max(ready, m_efuResourceReady);
+    if (decoded.lowerUsage.waitQ && m_fdiv.valid)
+        ready = std::max(ready, m_fdiv.readyCycle);
+    if (decoded.lowerUsage.waitP)
+    {
+        for (const ScalarPipelineEntry &entry : m_efu)
+            if (entry.valid)
+                ready = std::max(ready, entry.readyCycle);
+    }
+    if (decoded.lowerUsage.pipeline == PipelineXgkick && m_xgkick.active)
+        ready = std::max(ready, m_cycle + 1u);
+    return ready;
+}
+
+PS2_VU1_SEMPRE_EMBUTIR void VU1Interpreter::markPairWrites(const DecodedInstructionPair &decoded)
+{
+    const VfAccess lowerWrite = decoded.lowerUsage.vfWrite;
+    if (lowerWrite.reg != 0u &&
+        decoded.suppressedLowerVf != lowerWrite.reg)
+    {
+        const uint32_t latency = decoded.lowerUsage.vfLatency != 0u
+                                     ? decoded.lowerUsage.vfLatency
+                                     : decoded.lowerUsage.latency;
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            if ((lowerWrite.lanes & vu1passo::pista(component)) != 0u)
+                m_vfReady[lowerWrite.reg][component] = m_cycle + latency;
+        }
+    }
+
+    const VfAccess upperWrite = decoded.upperUsage.vfWrite;
+    if (upperWrite.reg != 0u)
+    {
+        const uint32_t latency = decoded.upperUsage.vfLatency != 0u
+                                     ? decoded.upperUsage.vfLatency
+                                     : decoded.upperUsage.latency;
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            if ((upperWrite.lanes & vu1passo::pista(component)) != 0u)
+                m_vfReady[upperWrite.reg][component] = m_cycle + latency;
+        }
+    }
+
+    if ((decoded.lowerUsage.viWrite & ~1u) != 0u)
+    {
+        for (uint32_t reg = 1; reg < m_viReady.size(); ++reg)
+        {
+            if ((decoded.lowerUsage.viWrite & (1u << reg)) != 0u)
+                m_viReady[reg] = m_cycle + (decoded.lowerUsage.viLatency != 0u ? decoded.lowerUsage.viLatency : decoded.lowerUsage.latency);
+        }
+    }
+    if (decoded.upperUsage.accWrite != 0u)
+    {
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            if ((decoded.upperUsage.accWrite & vu1passo::pista(component)) != 0u)
+                m_accReady[component] = m_cycle + kAccForwardLatency;
+        }
+    }
+}
+
+// Devolve PassoContinua (par executado), PassoPara (orcamento, parada pedida, instrucao reservada; nada executado) ou
+// PassoFim (par executado e o programa terminou).
+PS2_VU1_SEMPRE_EMBUTIR int VU1Interpreter::passoPar(const DecodedInstructionPair &decoded,
+                                                    uint8_t *vuData, uint32_t dataSize, GS &gs, PS2Memory *memory,
+                                                    uint32_t codeSize, uint64_t budgetEnd)
+{
+    if (m_cycle >= budgetEnd || m_stopRequested || m_state.pc + 8u > codeSize)
+        return PassoPara;
+    if (decoded.upperUsage.reserved || decoded.lowerUsage.reserved)
+    {
+        reportReservedInstruction(decoded.upperUsage.reserved, decoded.upperUsage.reserved ? decoded.upper : decoded.lower);
+        return PassoPara;
+    }
+
+    uint64_t readyCycle = calculatePairReadyCycle(decoded);
+    while (readyCycle > m_cycle)
+    {
+        if (readyCycle >= budgetEnd)
+        {
+            advanceTo(budgetEnd);
+            break;
+        }
+        advanceTo(readyCycle);
+        readyCycle = calculatePairReadyCycle(decoded);
+    }
+    if (m_cycle >= budgetEnd)
+        return PassoPara;
+
+    uint8_t writtenVi = 0u;
+    int32_t oldVi = 0;
+    for (uint32_t reg = 1; reg < 16u && (decoded.lowerUsage.viWrite & ~1u) != 0u; ++reg)
+    {
+        if ((decoded.lowerUsage.viWrite & (1u << reg)) != 0u)
+        {
+            writtenVi = static_cast<uint8_t>(reg);
+            oldVi = m_state.vi[reg];
+            break;
+        }
+    }
+
+    const VfAccess upperWrite = decoded.upperUsage.vfWrite;
+    const VfAccess lowerWrite = decoded.lowerUsage.vfWrite;
+    const bool hasUpperWrite = upperWrite.reg != 0u;
+    const bool hasLowerWrite = lowerWrite.reg != 0u && decoded.suppressedLowerVf != lowerWrite.reg;
+    const bool hasDistinctLowerWrite = hasLowerWrite && (!hasUpperWrite || lowerWrite.reg != upperWrite.reg);
+    float oldUpperVf[4]{};
+    float newUpperVf[4]{};
+    float oldLowerVf[4]{};
+    float newLowerVf[4]{};
+    float oldAcc[4]{};
+    float newAcc[4]{};
+    if (hasUpperWrite)
+        std::memcpy(oldUpperVf, m_state.vf[upperWrite.reg], sizeof(oldUpperVf));
+    if (hasDistinctLowerWrite)
+        std::memcpy(oldLowerVf, m_state.vf[lowerWrite.reg], sizeof(oldLowerVf));
+    if (decoded.upperUsage.accWrite != 0u)
+        std::memcpy(oldAcc, m_state.acc, sizeof(oldAcc));
+
+    if (decoded.iBit)
+    {
+        execUpper(decoded.upper);
+        float immediate = 0.0f;
+        std::memcpy(&immediate, &decoded.lower, sizeof(immediate));
+        m_state.i = normalizeOperand(immediate);
+    }
+    else if (decoded.upperVfShadowReg != 0u)
+    {
+        float oldVf[4]{};
+        float upperVf[4]{};
+        std::memcpy(oldVf, m_state.vf[decoded.upperVfShadowReg], sizeof(oldVf));
+        execUpper(decoded.upper);
+        std::memcpy(upperVf, m_state.vf[decoded.upperVfShadowReg], sizeof(upperVf));
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg], oldVf, sizeof(oldVf));
+        execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg], upperVf, sizeof(upperVf));
+    }
+    else
+    {
+        execUpper(decoded.upper);
+        execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+    }
+
+    m_viBranchBackupValid = false;
+
+    if (g_ps2xVuEscritaImediata)
+    {
+        // Mesmo valor final que a fila gravaria: o novo nas pistas enfileiradas, o antigo nas demais.
+        if (hasUpperWrite)
+        {
+            for (uint32_t component = 0; component < 4u; ++component)
+                if ((upperWrite.lanes & vu1passo::pista(component)) == 0u)
+                    m_state.vf[upperWrite.reg][component] = oldUpperVf[component];
+        }
+        if (hasDistinctLowerWrite)
+        {
+            for (uint32_t component = 0; component < 4u; ++component)
+                if ((lowerWrite.lanes & vu1passo::pista(component)) == 0u)
+                    m_state.vf[lowerWrite.reg][component] = oldLowerVf[component];
+        }
+        if (decoded.upperUsage.accWrite != 0u)
+        {
+            for (uint32_t component = 0; component < 4u; ++component)
+                if ((decoded.upperUsage.accWrite & vu1passo::pista(component)) == 0u)
+                    m_state.acc[component] = oldAcc[component];
+        }
+        if (writtenVi != 0u)
+            m_state.vi[writtenVi] = static_cast<int16_t>(m_state.vi[writtenVi]);
+    }
+    else
+    {
+        if (hasUpperWrite)
+        {
+            std::memcpy(newUpperVf, m_state.vf[upperWrite.reg], sizeof(newUpperVf));
+            std::memcpy(m_state.vf[upperWrite.reg], oldUpperVf, sizeof(oldUpperVf));
+            const uint32_t latency = decoded.upperUsage.vfLatency != 0u ? decoded.upperUsage.vfLatency : decoded.upperUsage.latency;
+            queueVfWrite(upperWrite.reg, upperWrite.lanes, newUpperVf, latency);
+        }
+        if (hasDistinctLowerWrite)
+        {
+            std::memcpy(newLowerVf, m_state.vf[lowerWrite.reg], sizeof(newLowerVf));
+            std::memcpy(m_state.vf[lowerWrite.reg], oldLowerVf, sizeof(oldLowerVf));
+            const uint32_t latency = decoded.lowerUsage.vfLatency != 0u ? decoded.lowerUsage.vfLatency : decoded.lowerUsage.latency;
+            queueVfWrite(lowerWrite.reg, lowerWrite.lanes, newLowerVf, latency);
+        }
+        if (decoded.upperUsage.accWrite != 0u)
+        {
+            std::memcpy(newAcc, m_state.acc, sizeof(newAcc));
+            std::memcpy(m_state.acc, oldAcc, sizeof(oldAcc));
+            // ACC is forwarded to the next upper instruction. Its arithmetic flags still use the normal four-cycle FMAC timeline.
+            queueAccWrite(decoded.upperUsage.accWrite, newAcc, kAccForwardLatency);
+        }
+        if (writtenVi != 0u)
+        {
+            const int32_t newVi = m_state.vi[writtenVi];
+            m_state.vi[writtenVi] = oldVi;
+            const uint32_t latency = decoded.lowerUsage.viLatency != 0u ? decoded.lowerUsage.viLatency : decoded.lowerUsage.latency;
+            queueViWrite(writtenVi, newVi, latency);
+        }
+    }
+
+    markPairWrites(decoded);
+    if (writtenVi != 0u && decoded.lowerUsage.delaysNextBranchRead)
+        recordViWriteForBranch(writtenVi, oldVi);
+
+    m_state.vf[0][0] = 0.0f;
+    m_state.vf[0][1] = 0.0f;
+    m_state.vf[0][2] = 0.0f;
+    m_state.vf[0][3] = 1.0f;
+    m_state.vi[0] = 0;
+
+    uint32_t nextPc = m_state.pc + 8u;
+    if (nextPc >= codeSize)
+        nextPc = 0u;
+    m_state.pc = nextPc;
+
+    if (m_state.branchPending)
+    {
+        if (m_state.branchDelay == 0u)
+        {
+            m_state.pc = m_state.branchTarget & microAddressMask();
+            m_state.branchPending = false;
+        }
+        else
+        {
+            --m_state.branchDelay;
+        }
+    }
+
+    const bool dHalt = decoded.dBit && m_state.dBitEnabled;
+    const bool tHalt = decoded.tBit && m_state.tBitEnabled;
+    const bool haltBit = dHalt || tHalt;
+    const bool haltBranch = haltBit && decoded.lowerUsage.pipeline == PipelineBranch;
+
+    bool programEnded = false;
+    if (m_state.haltAfterDelaySlot)
+    {
+        m_state.stoppedByD = m_pendingHaltD;
+        m_state.stoppedByT = m_pendingHaltT;
+        programEnded = true;
+    }
+    else if (m_state.ebit)
+        programEnded = true;
+    else if (haltBit && !haltBranch)
+    {
+        m_state.stoppedByD = dHalt;
+        m_state.stoppedByT = tHalt;
+        programEnded = true;
+    }
+    else if (decoded.eBit)
+        m_state.ebit = true;
+    else if (haltBranch)
+    {
+        m_state.haltAfterDelaySlot = true;
+        m_pendingHaltD = dHalt;
+        m_pendingHaltT = tHalt;
+    }
+
+    advanceOneCycle();
+    return programEnded ? PassoFim : PassoContinua;
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_traduzido.h b/ps2xRuntime/src/lib/vu/ps2_vu1_traduzido.h
new file mode 100644
index 0000000..28e9ead
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_traduzido.h
@@ -0,0 +1,47 @@
+// Blocos do VU1 traduzidos para C++ (gerados por tools/vu1_tradutor.py em generated/vu1/ps2_vu1_traduzido.cpp).
+// Cada versao do codigo do VU1 (hash FNV-1a dos 16 KB) tem uma tabela de 2048 entradas, uma por par: o bloco que comeca
+// naquele PC, ou nullptr. Cada bloco executa pares com VU1Interpreter::passoPar e o par ja decodificado como constante,
+// e volta ao interpretador quando o PC sai do caminho previsto. Sem tradução, tabelaAtual devolve nullptr.
+#ifndef PS2_VU1_TRADUZIDO_H
+#define PS2_VU1_TRADUZIDO_H
+
+#include <cstdint>
+
+class GS;
+class PS2Memory;
+class VU1Interpreter;
+
+struct Vu1Traduzido
+{
+    struct Contexto
+    {
+        uint8_t *vuData;
+        uint32_t dataSize;
+        GS *gs;
+        PS2Memory *memory;
+        uint32_t codeSize;
+        uint64_t budgetEnd;
+        uint64_t pares;
+    };
+    using Bloco = int (*)(VU1Interpreter &, Contexto &);
+
+    // Tabela da versao atual (recalcula o hash so quando a geracao muda). nullptr se a versao nao foi traduzida ou se
+    // PS2X_VU1_SEM_TRADUCAO estiver definida.
+    static const Bloco *tabelaAtual(const uint8_t *codigo, uint32_t tamanho, uint64_t geracao);
+
+    // Gerado: tabela de uma versao pelo hash, ou nullptr.
+    static const Bloco *tabelaPorHash(uint64_t hash);
+
+    // Gerado: primeira versao cujos pares traduzidos tem, todos, as mesmas palavras que o codigo atual. O resto da memoria
+    // (paginas que o programa nao usa) pode ter sobras de outros programas e mudar o hash sem mudar o que e executado.
+    static const Bloco *tabelaPorConteudo(const uint8_t *codigo, uint32_t tamanho);
+
+    // Contadores para [vu1-traducao]: trocas de codigo resolvidas pelo hash, pelo conteudo, ou sem traducao.
+    static uint64_t s_porHash, s_porConteudo, s_semTraducao;
+
+    // Gerado: uma especializacao por versao traduzida (membro, para ter o acesso de friend aos tipos do interpretador).
+    template <int N>
+    static int versao(VU1Interpreter &vu, Contexto &c);
+};
+
+#endif
