+const Vu1Traduzido::Bloco *Vu1Traduzido::tabelaAtual(const uint8_t *codigo, uint32_t tamanho, uint64_t geracao)
+{
+    // Os blocos traduzidos so implementam a escrita imediata: com PS2X_VU_FILAS=1 o interpretador faz tudo.
+    static const bool desligada = std::getenv("PS2X_VU1_SEM_TRADUCAO") != nullptr || !g_ps2xVuEscritaImediata;
+    static uint64_t ultimaGeracao = ~0ull;
+    static const uint8_t *ultimoCodigo = nullptr;
+    static const Bloco *ultimaTabela = nullptr;
+    if (desligada)
+        return nullptr;
+    if (geracao != ultimaGeracao || codigo != ultimoCodigo)
+    {
+        ultimaGeracao = geracao;
+        ultimoCodigo = codigo;
+        ultimaTabela = tabelaPorHash(hashCodigo(codigo, tamanho));
+        if (ultimaTabela != nullptr)
+            ++s_porHash;
+        else if ((ultimaTabela = tabelaPorConteudo(codigo, tamanho)) != nullptr)
+            ++s_porConteudo;
+        else
+            ++s_semTraducao;
+    }
+    return ultimaTabela;
+}
