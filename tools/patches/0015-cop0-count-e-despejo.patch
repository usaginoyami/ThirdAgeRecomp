+// Debug aid: PS2X_VRAM_DUMP=tick;tipo:bloco:larguraPaginas:w:h;... grava regioes da VRAM em ps2x_vram_<tipo>_<bloco>.raw
+// no diretorio atual, uma unica vez a partir desse tick. tipo 32 = RGBA de 4 bytes (PSMCT32), tipo 4 = 1 byte por indice (PSMT4).
+static void ps2xMaybeDumpVram(uint64_t tick, const uint8_t *vram)
+{
+    static uint64_t proximo = 0u;
+    const char *env = std::getenv("PS2X_VRAM_DUMP");
+    if (!env || !vram)
+        return;
+    std::istringstream spec(env);
+    std::string item;
+    std::getline(spec, item, ';');
+    if (tick < std::max<uint64_t>(proximo, std::strtoull(item.c_str(), nullptr, 0)))
+        return;
+    // PS2X_VRAM_DUMP_PASSO=N repete o despejo a cada N ticks, em arquivos com o tick no nome.
+    const char *passoEnv = std::getenv("PS2X_VRAM_DUMP_PASSO");
+    const uint64_t passo = passoEnv ? std::strtoull(passoEnv, nullptr, 0) : 0u;
+    if (proximo != 0u && passo == 0u)
+        return;
+    proximo = passo != 0u ? tick + passo : ~0ull;
+    const std::string sufixo = passo != 0u ? "_t" + std::to_string(tick) : std::string();
+    constexpr uint32_t mask = PS2_GS_VRAM_SIZE - 1u;
+    while (std::getline(spec, item, ';'))
+    {
+        unsigned tipo = 0u, bloco = 0u, largura = 0u, w = 0u, h = 0u;
+        if (std::sscanf(item.c_str(), "%u:%u:%u:%u:%u", &tipo, &bloco, &largura, &w, &h) != 5)
+            continue;
+        std::ofstream out("ps2x_vram_" + std::to_string(tipo) + "_" + std::to_string(bloco) + sufixo + ".raw", std::ios::binary);
+        for (uint32_t y = 0u; y < h; ++y)
+        {
+            for (uint32_t x = 0u; x < w; ++x)
+            {
+                if (tipo == 32u)
+                    out.write(reinterpret_cast<const char *>(vram + (GSPSMCT32::addrPSMCT32(bloco, largura, x, y) & mask & ~3u)), 4);
+                else
+                {
+                    const uint32_t nibble = GSPSMT4::addrPSMT4(bloco, largura, x, y);
+                    const uint8_t b = vram[(nibble >> 1u) & mask];
+                    const char indice = static_cast<char>((nibble & 1u) ? (b >> 4u) : (b & 0xFu));
+                    out.write(&indice, 1);
+                }
+            }
+        }
+    }
+    std::fprintf(stderr, "[vram] despejo feito no tick %llu%c", static_cast<unsigned long long>(tick), 10);
+}
