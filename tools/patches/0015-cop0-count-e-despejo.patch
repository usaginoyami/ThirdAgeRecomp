+// COP0 Count do EE (294,912 MHz). O codigo gerado le ctx->cop0_count direto, entao o valor e renovado na entrada de cada
+// funcao e nunca recua: o relogio do jogo (0x1be428) trata um valor menor como volta do contador de 32 bits.
+uint32_t ps2xCop0CountNow()
+{
+    static const auto inicio = std::chrono::steady_clock::now();
+    const auto decorrido = std::chrono::steady_clock::now() - inicio;
+    const uint64_t ns = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(decorrido).count());
+    return static_cast<uint32_t>((ns / 1000u) * 294912u / 1000u);
+}
