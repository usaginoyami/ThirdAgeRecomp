+        }
+        return true;
+    }();
+    (void)watchInit;
+    static std::atomic<int> watchHits{0};
+    if (watchHi != 0u && (guestAddr & 0x1FFFFFFFu) + size > watchLo && (guestAddr & 0x1FFFFFFFu) < watchHi &&
