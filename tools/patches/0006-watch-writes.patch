+    // Debug aid: PS2X_WATCH=0x448e10,0x40 logs guest writes into [start,start+len) (first 60 hits).
+    static uint32_t watchLo = 0u, watchHi = 0u;
+    static const bool watchInit = []
+    {
+        if (const char *env = std::getenv("PS2X_WATCH"))
